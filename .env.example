PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
MONGODB_URI=
# Optional override for the authentication database.
BETTER_AUTH_DB_URI=
# Use users on a new database or after a coordinated migration.
TUTORLAGBE_USER_COLLECTION=user
# Use a Stripe test API key and the signing secret from stripe listen.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local only. Enables authenticated mock payments without Stripe credentials.
ENABLE_MOCK_PAYMENTS=false
